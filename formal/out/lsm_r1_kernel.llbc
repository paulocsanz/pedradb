nv_lsm(s: &LsmState) -> bool {\n    let mut i = 0;\n    while i < MAX_LEVELS {\n        if !level_distinct(&s.levels[i]) {\n            return false;\n        }\n        let mut a = 0;\n        while a < s.levels[i].len {\n            if s.levels[i].entries[a].seq >= s.next_seq {\n                return false;\n            }\n            let mut j = i + 1;\n            while j < MAX_LEVELS {\n                if let Some(deeper) = level_get(&s.levels[j], s.levels[i].entries[a].key) {\n                    if deeper.seq >= s.levels[i].entries[a].seq {\n                        return false;\n                    }\n                }\n                j += 1;\n            }\n            a += 1;\n        }\n        i += 1;\n    }\n    true\n}","attr_info":{"attributes":[{"DocComment":" Inv-LSM: distinct keys per level, `next_seq` above every live seq,"},{"DocComment":" and recency consistency (`i < j` ⇒ any version at `i` is newer than"},{"DocComment":" any version of the same key at `j`)."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":671}],"output":{"Deduplicated":402}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":0,"beg":{"line":154,"col":0},"end":{"line":179,"col":1}},"generated_from_span":null},"bound_body_regions":11,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":0,"beg":{"line":154,"col":32},"end":{"line":154,"col":36}},"generated_from_span":null},"ty":{"Deduplicated":402}},{"index":1,"name":"s","span":{"data":{"file_id":0,"beg":{"line":154,"col":15},"end":{"line":154,"col":16}},"generated_from_span":null},"