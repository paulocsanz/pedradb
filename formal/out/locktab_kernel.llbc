ll},"source_text":"pub(crate) fn wait_for_deadlock(\n    owned: &HashMap<Bytes, u64>,\n    waiting: &HashMap<u64, Bytes>,\n    waiter: u64,\n    mut owner: u64,\n) -> bool {\n    let mut seen = HashSet::new();\n    while seen.insert(owner) {\n        let Some(k) = waiting.get(&owner) else {\n            return false;\n        };\n        let Some(&next) = owned.get(k) else {\n            return false;\n        };\n        if next == waiter {\n            return true;\n        }\n        owner = next;\n    }\n    true\n}","attr_info":{"attributes":[{"DocComment":" Wait-for cycle ⇒ deadlock (RFC-0150 P2c). Production lock table calls this."}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[1476,{"Ref":[{"Var":{"Free":0}},{"HashConsedValue":[514,{"Adt":{"id":{"Adt":0},"generics":{"regions":[],"types":[{"HashConsedValue":[478,{"Adt":{"id":{"Adt":1},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]},{"HashConsedValue":[479,{"Literal":{"UInt":"U64"}}]},{"Deduplicated":494},{"Deduplicated":513}],"const_generics":[],"trait_refs":[]}}}]},"Shared"]}]},{"HashConsedValue":[1477,{"Ref":[{"Var":{"Free":1}},{"HashConsedValue":[516,{"Adt":{"id":{"Adt":0},"generics":{"regions":[],"types":[{"Deduplicated":479},{"Deduplicated":478},{"Deduplicated":494},{"Deduplicated":513}],"const_generics":[],"trait_refs":[]}}}]},"Shared"]}]},{"Deduplicated":479},{"Deduplicated":479}],"output":{"HashConsedValue":[518,{"Literal":"Bool"}]}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id