nt":["hash",0]},{"Ident":["random",0]},{"Impl":{"Trait":8}},{"Ident":["finish",0]}]},{"key":{"Fun":33},"value":[{"Ident":["std",0]},{"Ident":["hash",0]},{"Ident":["random",0]},{"Impl":{"Trait":8}},{"Ident":["write",0]}]},{"key":{"Fun":34},"value":[{"Ident":["std",0]},{"Ident":["hash",0]},{"Ident":["random",0]},{"Impl":{"Trait":8}},{"Ident":["write_str",0]}]},{"key":{"Global":4},"value":[{"Ident":["bytes",0]},{"Ident":["bytes",0]},{"Impl":{"Trait":9}},{"Ident":["{vtable}",0]}]},{"key":{"Fun":35},"value":[{"Ident":["bytes",0]},{"Ident":["bytes",0]},{"Impl":{"Trait":9}},{"Ident":["eq",0]}]}],"assoc_item_names":[{"types":[],"methods":["assert_receiver_is_total_eq","assert_fields_are_eq"],"consts":[]},{"types":[],"methods":["hash","hash_slice"],"consts":[]},{"types":["Hasher"],"methods":["build_hasher","hash_one"],"consts":[]},{"types":[],"methods":["drop_glue"],"consts":[]},{"types":[],"methods":["borrow"],"consts":[]},{"types":[],"methods":["eq","ne"],"consts":[]},{"types":[],"methods":["finish","write","write_u8","write_u16","write_u32","write_u64","write_u128","write_usize","write_i8","write_i16","write_i32","write_i64","write_i128","write_isize","write_length_prefix","write_str"],"consts":[]}],"short_names":[{"key":{"TraitImpl":0},"value":[{"Ident":["impl_Eq_for_u64",0]}]},{"key":{"TraitImpl":1},"value":[{"Ident":["impl_Hash_for_u64",0]}]},{"key":{"TraitImpl":2},"value":[{"Ident":["impl_BuildHasher_for_RandomState",0]}]},{"key":{"TraitImpl":3},"value":[{"Ident":["impl_Destruct_for_HashSet",0]}]},{"key":{"TraitImpl":4},"value":[{"Ident":["impl_Borrow_for_T",0]}]},{"key":{"TraitImpl":5},"value":[{"Ident":["impl_Eq_for_Bytes",0]}]},{"key":{"TraitImpl":6},"value":[{"Ident":["impl_Hash_for_Bytes",0]}]},{"key":{"TraitImpl":7},"value":[{"Ident":["impl_PartialEq_u64_for_u64",0]}]},{"key":{"Fun":9},"value":[{"Impl":{"Trait":1}},{"Ident":["hash",0]}]},{"key":{"Fun":10},"value":[{"Impl":{"Trait":1}},{"Ident":["hash_slice",0]}]},{"key":{"Global":0},"value":[{"Impl":{"Trait":2}},{"Ident":["{vtable}",0]}]},{"key":{"TraitImpl":8},"value":[{"Ident":["impl_Hasher_for_DefaultHasher",0]}]},{"key":{"Fun":11},"value":[{"Ident":["build_hasher",0]}]},{"key":{"Fun":12},"value":[{"Ident":["drop_glue",0]}]},{"key":{"Global":1},"value":[{"Impl":{"Trait":4}},{"Ident":["{vtable}",0]}]},{"key":{"Fun":13},"value":[{"Ident":["borrow",0]}]},{"key":{"TraitImpl":9},"value":[{"Ident":["impl_PartialEq_Bytes_for_Bytes",0]}]},{"key":{"Fun":14},"value":[{"Impl":{"Trait":6}},{"Ident":["hash",0]}]},{"key":{"Global":2},"value":[{"Impl":{"Trait":7}},{"Ident":["{vtable}",0]}]},{"key":{"Fun":30},"value":[{"Impl":{"Trait":7}},{"Ident":["eq",0]}]},{"key":{"Fun":31},"value":[{"Impl":{"Trait":7}},{"Ident":["ne",0]}]},{"key":{"Global":3},"value":[{"Impl":{"Trait":8}},{"Ident":["{vtable}",0]}]},{"key":{"Fun":32},"value":[{"Ident":["finish",0]}]},{"key":{"Fun":33},"value":[{"Ident":["write",0]}]},{"key":{"Fun":34},"value":[{"Impl":{"Trait":8}},{"Ident":["write_str",0]}]},{"key":{"Global":4},"value":[{"Impl":{"Trait":9}},{"Ident":["{vtable}",0]}]},{"key":{"Fun":35},"value":[{"Impl":{"Trait":9}},{"Ident":["eq",0]}]},{"key":{"TraitDecl":2},"value":[{"Ident":["BuildHasher",0]}]},{"key":{"Fun":1},"value":[{"Ident":["wait_for_deadlock_as_is",0]}]},{"key":{"Fun":2},"value":[{"Ident":["new",0]}]},{"key":{"Fun":4},"value":[{"Ident":["get",0]}]},{"key":{"TraitDecl":1},"value":[{"Ident":["Hash",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["Eq",0]}]},{"key":{"TraitDecl":5},"value":[{"Ident":["PartialEq",0]}]},{"key":{"Fun":26},"value":[{"Ident":["write_i128",0]}]},{"key":{"Fun":25},"value":[{"Ident":["write_i64",0]}]},{"key":{"Fun":28},"value":[{"Ident":["write_length_prefix",0]}]},{"key":{"Type":2},"value":[{"Ident":["RandomState",0]}]},{"key":{"Type":3},"value":[{"Ident":["Global",0]}]},{"key":{"Type":4},"value":[{"Ident":["HashSet",0]}]},{"key":{"Type":0},"value":[{"Ident":["HashMap",0]}]},{"key":{"Type":5},"value":[{"Ident":["Option",0]}]},{"key":{"Fun":22},"value":[{"Ident":["write_i8",0]}]},{"key":{"TraitDecl":6},"value":[{"Ident":["Hasher",0]}]},{"key":{"Fun":21},"value":[{"Ident":["write_usize",0]}]},{"key":{"Type":1},"value":[{"Ident":["Bytes",0]}]},{"key":{"Fun":3},"value":[{"Ident":["insert",0]}]},{"key":{"TraitDecl":3},"value":[{"Ident":["Destruct",0]}]},{"key":{"TraitDecl":4},"value":[{"Ident":["Borrow",0]}]},{"key":{"Fun":5},"value":[{"Ident":["assert_receiver_is_total_eq",0]}]},{"key":{"Fun":20},"value":[{"Ident":["write_u128",0]}]},{"key":{"Fun":27},"value":[{"Ident":["write_isize",0]}]},{"key":{"Fun":0},"value":[{"Ident":["wait_for_deadlock",0]}]},{"key":{"Fun":6},"value":[{"Ident":["assert_fields_are_eq",0]}]},{"key":{"Type":7},"value":[{"Ident":["DefaultHasher",0]}]},{"key":{"Fun":17},"value":[{"Ident":["write_u16",0]}]},{"key":{"Fun":16},"value":[{"Ident":["write_u8",0]}]},{"key":{"Fun":18},"value":[{"Ident":["write_u32",0]}]},{"key":{"Fun":19},"value":[{"Ident":["write_u64",0]}]},{"key":{"Fun":23},"value":[{"Ident":["write_i16",0]}]},{"key":{"Fun":8},"value":[{"Ident":["hash_one",0]}]},{"key":{"Fun":24},"value":[{"Ident":["write_i32",0]}]}],"type_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["collections",0]},{"Ident":["hash",0]},{"Ident":["map",0]},{"Ident":["HashMap",0]}],"span":{"data":{"file_id":1,"beg":{"line":246,"col":0},"end":{"line":251,"col":1}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A [hash map] implemented with quadratic probing and SIMD lookup."},{"DocComment":""},{"DocComment":" By default, `HashMap` uses a hashing algorithm selected to provide"},{"DocComment":" resistance against HashDoS attacks. The algorithm is randomly seeded, and a"},{"DocComment":" reasonable best-effort is made to generate this seed from a high quality,"},{"DocComment":" secure source of randomness provided by the host without blocking the"},{"DocComment":" program. Because of this, the randomness of the seed depends on the output"},{"DocComment":" quality of the system's random number generator when the seed is created."},{"DocComment":" In particular, seeds generated when the system's entropy pool is abnormally"},{"DocComment":" low such as during system boot may be of a lower quality."},{"DocComment":""},{"DocComment":" The default hashing algorithm is currently SipHash 1-3, though this is"},{"DocComment":" subject to change at any point in the future. While its performance is very"},{"DocComment":" competitive for medium sized keys, other hashing algorithms will outperform"},{"DocComment":" it for small keys such as integers as well as large keys such as long"},{"DocComment":" strings, though those algorithms will typically *not* protect against"},{"DocComment":" attacks such as HashDoS."},{"DocComment":""},{"DocComment":" The hashing algorithm can be replaced on a per-`HashMap` basis using the"},{"DocComment":" [`default`], [`with_hasher`], and [`with_capacity_and_hasher`] methods."},{"DocComment":" There are many alternative [hashing algorithms available on crates.io]."},{"DocComment":""},{"DocComment":" It is required that the keys implement the [`Eq`] and [`Hash`] traits, although"},{"DocComment":" this can frequently be achieved by using `#[derive(PartialEq, Eq, Hash)]`."},{"DocComment":" If you implement these yourself, it is important that the following"},{"DocComment":" property holds:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" k1 == k2 -> hash(k1) == hash(k2)"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In other words, if two keys are equal, their hashes must be equal."},{"DocComment":" Violating this property is a logic error."},{"DocComment":""},{"DocComment":" It is also a logic error for a key to be modified in such a way that the key's"},{"DocComment":" hash, as determined by the [`Hash`] trait, or its equality, as determined by"},{"DocComment":" the [`Eq`] trait, changes while it is in the map. This is normally only"},{"DocComment":" possible through [`Cell`], [`RefCell`], global state, I/O, or unsafe code."},{"DocComment":""},{"DocComment":" The behavior resulting from either logic error is not specified, but will"},{"DocComment":" be encapsulated to the `HashMap` that observed the logic error and not"},{"DocComment":" result in undefined behavior. This could include panics, incorrect results,"},{"DocComment":" aborts, memory leaks, and non-termination."},{"DocComment":""},{"DocComment":" The hash table implementation is a Rust port of Google's [SwissTable]."},{"DocComment":" The original C++ version of SwissTable can be found [here], and this"},{"DocComment":" [CppCon talk] gives an overview of how the algorithm works."},{"DocComment":""},{"DocComment":" [hash map]: crate::collections#use-a-hashmap-when"},{"DocComment":" [hashing algorithms available on crates.io]: https://crates.io/keywords/hasher"},{"DocComment":" [SwissTable]: https://abseil.io/blog/20180927-swisstables"},{"DocComment":" [here]: https://github.com/abseil/abseil-cpp/blob/master/absl/container/internal/raw_hash_set.h"},{"DocComment":" [CppCon talk]: https://www.youtube.com/watch?v=ncHmEUmJZf4"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" // Type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `HashMap<String, String>` in this example)."},{"DocComment":" let mut book_reviews = HashMap::new();"},{"DocComment":""},{"DocComment":" // Review some books."},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"Adventures of Huckleberry Finn\".to_string(),"},{"DocComment":"     \"My favorite book.\".to_string(),"},{"DocComment":" );"},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"Grimms' Fairy Tales\".to_string(),"},{"DocComment":"     \"Masterpiece.\".to_string(),"},{"DocComment":" );"},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"Pride and Prejudice\".to_string(),"},{"DocComment":"     \"Very enjoyable.\".to_string(),"},{"DocComment":" );"},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"The Adventures of Sherlock Holmes\".to_string(),"},{"DocComment":"     \"Eye lyked it alot.\".to_string(),"},{"DocComment":" );"},{"DocComment":""},{"DocComment":" // Check for a specific one."},{"DocComment":" // When collections store owned values (String), they can still be"},{"DocComment":" // queried using references (&str)."},{"DocComment":" if !book_reviews.contains_key(\"Les Misérables\") {"},{"DocComment":"     println!(\"We've got {} reviews, but Les Misérables ain't one.\","},{"DocComment":"              book_reviews.len());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // oops, this review has a lot of spelling mistakes, let's delete it."},{"DocComment":" book_reviews.remove(\"The Adventures of Sherlock Holmes\");"},{"DocComment":""},{"DocComment":" // Look up the values associated with some keys."},{"DocComment":" let to_find = [\"Pride and Prejudice\", \"Alice's Adventure in Wonderland\"];"},{"DocComment":" for &book in &to_find {"},{"DocComment":"     match book_reviews.get(book) {"},{"DocComment":"         Some(review) => println!(\"{book}: {review}\"),"},{"DocComment":"         None => println!(\"{book} is unreviewed.\")"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Look up the value for a key (will panic if the key is not found)."},{"DocComment":" println!(\"Review for Jane: {}\", book_reviews[\"Pride and Prejudice\"]);"},{"DocComment":""},{"DocComment":" // Iterate over everything."},{"DocComment":" for (book, review) in &book_reviews {"},{"DocComment":"     println!(\"{book}: \\\"{review}\\\"\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A `HashMap` with a known list of items can be initialized from an array:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" let solar_distance = HashMap::from(["},{"DocComment":"     (\"Mercury\", 0.4),"},{"DocComment":"     (\"Venus\", 0.7),"},{"DocComment":"     (\"Earth\", 1.0),"},{"DocComment":"     (\"Mars\", 1.5),"},{"DocComment":" ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## `Entry` API"},{"DocComment":""},{"DocComment":" `HashMap` implements an [`Entry` API](#method.entry), which allows"},{"DocComment":" for complex methods of getting, setting, updating and removing keys and"},{"DocComment":" their values:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" // type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `HashMap<&str, u8>` in this example)."},{"DocComment":" let mut player_stats = HashMap::new();"},{"DocComment":""},{"DocComment":" fn random_stat_buff() -> u8 {"},{"DocComment":"     // could actually return some random value here - let's just return"},{"DocComment":"     // some fixed value for now"},{"DocComment":"     42"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // insert a key only if it doesn't already exist"},{"DocComment":" player_stats.entry(\"health\").or_insert(100);"},{"DocComment":""},{"DocComment":" // insert a key using a function that provides a new value only if it"},{"DocComment":" // doesn't already exist"},{"DocComment":" player_stats.entry(\"defence\").or_insert_with(random_stat_buff);"},{"DocComment":""},{"DocComment":" // update a key, guarding against the key possibly not being set"},{"DocComment":" let stat = player_stats.entry(\"attack\").or_insert(100);"},{"DocComment":" *stat += random_stat_buff();"},{"DocComment":""},{"DocComment":" // modify an entry before an insert with in-place mutation"},{"DocComment":" player_stats.entry(\"mana\").and_modify(|mana| *mana += 200).or_insert(100);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Usage with custom key types"},{"DocComment":""},{"DocComment":" The easiest way to use `HashMap` with a custom key type is to derive [`Eq`] and [`Hash`]."},{"DocComment":" We must also derive [`PartialEq`]."},{"DocComment":""},{"DocComment":" [`RefCell`]: crate::cell::RefCell"},{"DocComment":" [`Cell`]: crate::cell::Cell"},{"DocComment":" [`default`]: Default::default"},{"DocComment":" [`with_hasher`]: Self::with_hasher"},{"DocComment":" [`with_capacity_and_hasher`]: Self::with_capacity_and_hasher"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" #[derive(Hash, Eq, PartialEq, Debug)]"},{"DocComment":" struct Viking {"},{"DocComment":"     name: String,"},{"DocComment":"     country: String,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Viking {"},{"DocComment":"     /// Creates a new Viking."},{"DocComment":"     fn new(name: &str, country: &str) -> Viking {"},{"DocComment":"         Viking { name: name.to_string(), country: country.to_string() }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Use a HashMap to store the vikings' health points."},{"DocComment":" let vikings = HashMap::from(["},{"DocComment":"     (Viking::new(\"Einar\", \"Norway\"), 25),"},{"DocComment":"     (Viking::new(\"Olaf\", \"Denmark\"), 24),"},{"DocComment":"     (Viking::new(\"Harald\", \"Iceland\"), 12),"},{"DocComment":" ]);"},{"DocComment":""},{"DocComment":" // Use derived implementation to print the status of the vikings."},{"DocComment":" for (viking, health) in &vikings {"},{"DocComment":"     println!(\"{viking:?} has {health} hp\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Usage in `const` and `static`"},{"DocComment":""},{"DocComment":" As explained above, `HashMap` is randomly seeded: each `HashMap` instance uses a different seed,"},{"DocComment":" which means that `HashMap::new` normally cannot be used in a `const` or `static` initializer."},{"DocComment":""},{"DocComment":" However, if you need to use a `HashMap` in a `const` or `static` initializer while retaining"},{"DocComment":" random seed generation, you can wrap the `HashMap` in [`LazyLock`]."},{"DocComment":""},{"DocComment":" Alternatively, you can construct a `HashMap` in a `const` or `static` initializer using a different"},{"DocComment":" hasher that does not rely on a random seed. **Be aware that a `HashMap` created this way is not"},{"DocComment":" resistant to HashDoS attacks!**"},{"DocComment":""},{"DocComment":" [`LazyLock`]: crate::sync::LazyLock"},{"DocComment":" ```rust"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":" use std::hash::{BuildHasherDefault, DefaultHasher};"},{"DocComment":" use std::sync::{LazyLock, Mutex};"},{"DocComment":""},{"DocComment":" // HashMaps with a fixed, non-random hasher"},{"DocComment":" const NONRANDOM_EMPTY_MAP: HashMap<String, Vec<i32>, BuildHasherDefault<DefaultHasher>> ="},{"DocComment":"     HashMap::with_hasher(BuildHasherDefault::new());"},{"DocComment":" static NONRANDOM_MAP: Mutex<HashMap<String, Vec<i32>, BuildHasherDefault<DefaultHasher>>> ="},{"DocComment":"     Mutex::new(HashMap::with_hasher(BuildHasherDefault::new()));"},{"DocComment":""},{"DocComment":" // HashMaps using LazyLock to retain random seeding"},{"DocComment":" const RANDOM_EMPTY_MAP: LazyLock<HashMap<String, Vec<i32>>> ="},{"DocComment":"     LazyLock::new(HashMap::new);"},{"DocComment":" static RANDOM_MAP: LazyLock<Mutex<HashMap<String, Vec<i32>>>> ="},{"DocComment":"     LazyLock::new(|| Mutex::new(HashMap::new()));"},{"DocComment":" ```"},{"Builtin":{"RustcDiagnosticItem":"HashMap"}}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"HashMap"},"generics":{"regions":[],"types":[{"index":0,"name":"K","variance":"Covariant"},{"index":1,"name":"V","variance":"Covariant"},{"index":2,"name":"S","variance":"Covariant"},{"index":3,"name":"A","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":1,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["bytes",0]},{"Ident":["Bytes",0]}],"span":{"data":{"file_id":5,"beg":{"line":101,"col":0},"end":{"line":101,"col":16}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A cheaply cloneable and sliceable chunk of contiguous memory."},{"DocComment":""},{"DocComment":" `Bytes` is an efficient container for storing and operating on contiguous"},{"DocComment":" slices of memory. It is intended for use primarily in networking code, but"},{"DocComment":" could have applications elsewhere as well."},{"DocComment":""},{"DocComment":" `Bytes` values facilitate zero-copy network programming by allowing multiple"},{"DocComment":" `Bytes` objects to point to the same underlying memory."},{"DocComment":""},{"DocComment":" `Bytes` does not have a single implementation. It is an interface, whose"},{"DocComment":" exact behavior is implemented through dynamic dispatch in several underlying"},{"DocComment":" implementations of `Bytes`."},{"DocComment":""},{"DocComment":" All `Bytes` implementations must fulfill the following requirements:"},{"DocComment":" - They are cheaply cloneable and thereby shareable between an unlimited amount"},{"DocComment":"   of components, for example by modifying a reference count."},{"DocComment":" - Instances can be sliced to refer to a subset of the original buffer."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Bytes;"},{"DocComment":""},{"DocComment":" let mut mem = Bytes::from(\"Hello world\");"},{"DocComment":" let a = mem.slice(0..5);"},{"DocComment":""},{"DocComment":" assert_eq!(a, \"Hello\");"},{"DocComment":""},{"DocComment":" let b = mem.split_to(6);"},{"DocComment":""},{"DocComment":" assert_eq!(mem, \"world\");"},{"DocComment":" assert_eq!(b, \"Hello \");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Memory layout"},{"DocComment":""},{"DocComment":" The `Bytes` struct itself is fairly small, limited to 4 `usize` fields used"},{"DocComment":" to track information about which segment of the underlying memory the"},{"DocComment":" `Bytes` handle has access to."},{"DocComment":""},{"DocComment":" `Bytes` keeps both a pointer to the shared state containing the full memory"},{"DocComment":" slice and a pointer to the start of the region visible by the handle."},{"DocComment":" `Bytes` also tracks the length of its view into the memory."},{"DocComment":""},{"DocComment":" # Sharing"},{"DocComment":""},{"DocComment":" `Bytes` contains a vtable, which allows implementations of `Bytes` to define"},{"DocComment":" how sharing/cloning is implemented in detail."},{"DocComment":" When `Bytes::clone()` is called, `Bytes` will call the vtable function for"},{"DocComment":" cloning the backing storage in order to share it behind multiple `Bytes`"},{"DocComment":" instances."},{"DocComment":""},{"DocComment":" For `Bytes` implementations which refer to constant memory (e.g. created"},{"DocComment":" via `Bytes::from_static()`) the cloning implementation will be a no-op."},{"DocComment":""},{"DocComment":" For `Bytes` implementations which point to a reference counted shared storage"},{"DocComment":" (e.g. an `Arc<[u8]>`), sharing will be implemented by increasing the"},{"DocComment":" reference count."},{"DocComment":""},{"DocComment":" Due to this mechanism, multiple `Bytes` instances may point to the same"},{"DocComment":" shared memory region."},{"DocComment":" Each `Bytes` instance can point to different sections within that"},{"DocComment":" memory region, and `Bytes` instances may or may not have overlapping views"},{"DocComment":" into the memory."},{"DocComment":""},{"DocComment":" The following diagram visualizes a scenario where 2 `Bytes` instances make"},{"DocComment":" use of an `Arc`-based backing storage, and provide access to different views:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":""},{"DocComment":"    Arc ptrs                   ┌─────────┐"},{"DocComment":"    ________________________ / │ Bytes 2 │"},{"DocComment":"   /                           └─────────┘"},{"DocComment":"  /          ┌───────────┐     |         |"},{"DocComment":" |_________/ │  Bytes 1  │     |         |"},{"DocComment":" |           └───────────┘     |         |"},{"DocComment":" |           |           | ___/ data     | tail"},{"DocComment":" |      data |      tail |/              |"},{"DocComment":" v           v           v               v"},{"DocComment":" ┌─────┬─────┬───────────┬───────────────┬─────┐"},{"DocComment":" │ Arc │     │           │               │     │"},{"DocComment":" └─────┴─────┴───────────┴───────────────┴─────┘"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"aarch64-apple-darwin","value":{"size":32,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[8,16,24,0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":2,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["hash",0]},{"Ident":["random",0]},{"Ident":["RandomState",0]}],"span":{"data":{"file_id":7,"beg":{"line":35,"col":0},"end":{"line":35,"col":22}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `RandomState` is the default state for [`HashMap`] types."},{"DocComment":""},{"DocComment":" A particular instance `RandomState` will create the same instances of"},{"DocComment":" [`Hasher`], but the hashers created by two different `RandomState`"},{"DocComment":" instances are unlikely to produce the same result for the same values."},{"DocComment":""},{"DocComment":" [`HashMap`]: crate::collections::HashMap"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":" use std::hash::RandomState;"},{"DocComment":""},{"DocComment":" let s = RandomState::new();"},{"DocComment":" let mut map = HashMap::with_hasher(s);"},{"DocComment":" map.insert(1, 2);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"aarch64-apple-darwin","value":{"size":16,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,8],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":3,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Ident":["Global",0]}],"span":{"data":{"file_id":9,"beg":{"line":58,"col":0},"end":{"line":58,"col":17}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The global memory allocator."},{"DocComment":""},{"DocComment":" This type implements the [`Allocator`] trait by forwarding calls"},{"DocComment":" to the allocator registered with the `#[global_allocator]` attribute"},{"DocComment":" if there is one, or the `std` crate’s default."},{"DocComment":""},{"DocComment":" Note: while this type is unstable, the functionality it provides can be"},{"DocComment":" accessed through the [free functions in `alloc`](self#functions)."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"GlobalAlloc","diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[]},"layout":[{"key":"aarch64-apple-darwin","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":4,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["collections",0]},{"Ident":["hash",0]},{"Ident":["set",0]},{"Ident":["HashSet",0]}],"span":{"data":{"file_id":11,"beg":{"line":126,"col":0},"end":{"line":130,"col":1}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A [hash set] implemented as a `HashMap` where the value is `()`."},{"DocComment":""},{"DocComment":" As with the [`HashMap`] type, a `HashSet` requires that the elements"},{"DocComment":" implement the [`Eq`] and [`Hash`] traits. This can frequently be achieved by"},{"DocComment":" using `#[derive(PartialEq, Eq, Hash)]`. If you implement these yourself,"},{"DocComment":" it is important that the following property holds:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" k1 == k2 -> hash(k1) == hash(k2)"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In other words, if two keys are equal, their hashes must be equal."},{"DocComment":" Violating this property is a logic error."},{"DocComment":""},{"DocComment":" It is also a logic error for a key to be modified in such a way that the key's"},{"DocComment":" hash, as determined by the [`Hash`] trait, or its equality, as determined by"},{"DocComment":" the [`Eq`] trait, changes while it is in the map. This is normally only"},{"DocComment":" possible through [`Cell`], [`RefCell`], global state, I/O, or unsafe code."},{"DocComment":""},{"DocComment":" The behavior resulting from either logic error is not specified, but will"},{"DocComment":" be encapsulated to the `HashSet` that observed the logic error and not"},{"DocComment":" result in undefined behavior. This could include panics, incorrect results,"},{"DocComment":" aborts, memory leaks, and non-termination."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashSet;"},{"DocComment":" // Type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `HashSet<String>` in this example)."},{"DocComment":" let mut books = HashSet::new();"},{"DocComment":""},{"DocComment":" // Add some books."},{"DocComment":" books.insert(\"A Dance With Dragons\".to_string());"},{"DocComment":" books.insert(\"To Kill a Mockingbird\".to_string());"},{"DocComment":" books.insert(\"The Odyssey\".to_string());"},{"DocComment":" books.insert(\"The Great Gatsby\".to_string());"},{"DocComment":""},{"DocComment":" // Check for a specific one."},{"DocComment":" if !books.contains(\"The Winds of Winter\") {"},{"DocComment":"     println!(\"We have {} books, but The Winds of Winter ain't one.\","},{"DocComment":"              books.len());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Remove a book."},{"DocComment":" books.remove(\"The Odyssey\");"},{"DocComment":""},{"DocComment":" // Iterate over everything."},{"DocComment":" for book in &books {"},{"DocComment":"     println!(\"{book}\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The easiest way to use `HashSet` with a custom type is to derive"},{"DocComment":" [`Eq`] and [`Hash`]. We must also derive [`PartialEq`],"},{"DocComment":" which is required if [`Eq`] is derived."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashSet;"},{"DocComment":" #[derive(Hash, Eq, PartialEq, Debug)]"},{"DocComment":" struct Viking {"},{"DocComment":"     name: String,"},{"DocComment":"     power: usize,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut vikings = HashSet::new();"},{"DocComment":""},{"DocComment":" vikings.insert(Viking { name: \"Einar\".to_string(), power: 9 });"},{"DocComment":" vikings.insert(Viking { name: \"Einar\".to_string(), power: 9 });"},{"DocComment":" vikings.insert(Viking { name: \"Olaf\".to_string(), power: 4 });"},{"DocComment":" vikings.insert(Viking { name: \"Harald\".to_string(), power: 8 });"},{"DocComment":""},{"DocComment":" // Use derived implementation to print the vikings."},{"DocComment":" for x in &vikings {"},{"DocComment":"     println!(\"{x:?}\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A `HashSet` with a known list of items can be initialized from an array:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashSet;"},{"DocComment":""},{"DocComment":" let viking_names = HashSet::from([\"Einar\", \"Olaf\", \"Harald\"]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [hash set]: crate::collections#use-the-set-variant-of-any-of-these-maps-when"},{"DocComment":" [`HashMap`]: crate::collections::HashMap"},{"DocComment":" [`RefCell`]: crate::cell::RefCell"},{"DocComment":" [`Cell`]: crate::cell::Cell"},{"DocComment":""},{"DocComment":" # Usage in `const` and `static`"},{"DocComment":""},{"DocComment":" Like `HashMap`, `HashSet` is randomly seeded: each `HashSet` instance uses a different seed,"},{"DocComment":" which means that `HashSet::new` cannot be used in const context. To construct a `HashSet` in the"},{"DocComment":" initializer of a `const` or `static` item, you will have to use a different hasher that does not"},{"DocComment":" involve a random seed, as demonstrated in the following example. **A `HashSet` constructed this"},{"DocComment":" way is not resistant against HashDoS!**"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::collections::HashSet;"},{"DocComment":" use std::hash::{BuildHasherDefault, DefaultHasher};"},{"DocComment":" use std::sync::Mutex;"},{"DocComment":""},{"DocComment":" const EMPTY_SET: HashSet<String, BuildHasherDefault<DefaultHasher>> ="},{"DocComment":"     HashSet::with_hasher(BuildHasherDefault::new());"},{"DocComment":" static SET: Mutex<HashSet<String, BuildHasherDefault<DefaultHasher>>> ="},{"DocComment":"     Mutex::new(HashSet::with_hasher(BuildHasherDefault::new()));"},{"DocComment":" ```"},{"Builtin":{"RustcDiagnosticItem":"HashSet"}}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"HashSet"},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"},{"index":1,"name":"S","variance":"Covariant"},{"index":2,"name":"A","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":5,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["option",0]},{"Ident":["Option",0]}],"span":{"data":{"file_id":12,"beg":{"line":597,"col":0},"end":{"line":597,"col":18}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The `Option` type. See [the module level documentation](self) for more."},{"Builtin":{"RustcDiagnosticItem":"Option"}}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Option","diagnostic_item":"Option"},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":12,"beg":{"line":601,"col":4},"end":{"line":601,"col":8}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" No value."}],"inline":null,"rename":null,"public":true},"name":"None","fields":[],"discriminant":{"Scalar":{"Si