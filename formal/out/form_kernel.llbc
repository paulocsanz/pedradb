,"end":{"line":66,"col":1}},"generated_from_span":null},"source_text":"pub fn form_decode(s: &str) -> Vec<u8> {\n    let b = s.as_bytes();\n    let mut out = Vec::with_capacity(b.len());\n    let mut i = 0;\n    while i < b.len() {\n        if plus_before_percent() && b[i] == b'+' {\n            out.push(form_plus_byte(b[i]));\n            i += 1;\n            continue;\n        }\n        if b[i] == b'%' && i + 2 < b.len() {\n            if let (Some(h), Some(l)) = (from_hex(b[i + 1]), from_hex(b[i + 2])) {\n                out.push((h << 4) | l);\n                i += 3;\n                continue;\n            }\n        }\n        out.push(b[i]);\n        i += 1;\n    }\n    out\n}","attr_info":{"attributes":[{"DocComment":" Query-value decode: `+` → space, then `%HH`."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":5487}],"output":{"HashConsedValue":[5399,{"Adt":{"id":{"Adt":0},"generics":{"regions":[],"types":[{"HashConsedValue":[397,{"Literal":{"UInt":"U8"}}]}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":0,"beg":{"line":45,"col":0},"end":{"line":66,"col":1}},"generated_from_span":null},"bound_body_regions":28,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":0,"beg":{"line":45,"col":31},"end":{"line":45,"col":38}},"generated_from_span":null},"ty":{"Deduplicated":5399}},{"index":1,"name":"s","span":{"data":{"file_id":0,"beg":{"line":45,"col":19},"end":{"line":45,"col":20}},"generated_from_span":null},"ty":{"HashConsedValue":[420,{"Ref":[{"Body":1},{"Deduplicated":