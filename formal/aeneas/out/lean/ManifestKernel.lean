def sst_recover_action
  (obs : ManifestObs) (listed : ListedSst) : Result SstRecoverAction := do
  match obs with
  | ManifestObs.Absent => ok SstRecoverAction.ScanAndInstall
  | ManifestObs.Inventory =>
    match listed with
    | ListedSst.AllPresent => ok SstRecoverAction.ServeInventory
    | ListedSst.Missing _ => ok SstRecoverAction.RefuseOpen
  | ManifestObs.Corrupt => ok SstRecoverAction.RefuseOpen

