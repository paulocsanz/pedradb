    Visibility: public -/
def sst_recover_action_as_is_scan_on_damage
  (obs : ManifestObs) (listed : ListedSst) : Result SstRecoverAction := do
  match obs with
  | ManifestObs.Absent => ok SstRecoverAction.ScanAndInstall
  | ManifestObs.Inventory =>
    let b ←
      ListedSst.Insts.CoreCmpPartialEqListedSst.eq listed ListedSst.AllPresent
    if b
    then ok SstRecoverAction.ServeInventory
    else ok SstRecoverAction.ScanAndInstall
  | ManifestObs.Corrupt => ok SstRecoverAction.ScanAndInstall

