def vlog_recover_action
  (blob_active : Bool) (wants_large : Bool) (primary_exists : Bool)
  (use_new : Bool) (new_exists : Bool) :
  Result VlogRecoverAction
  := do
  if blob_active
  then ok VlogRecoverAction.OpenBlob
  else
    let swung_and_staged ← if use_new
                             then ok new_exists
                             else ok false
    if wants_large
    then
      if swung_and_staged
      then ok VlogRecoverAction.OpenNew
      else
        if primary_exists
        then ok VlogRecoverAction.OpenPrimary
        else
          if use_new
          then ok VlogRecoverAction.RefuseOpen
          else ok VlogRecoverAction.CreateEmptyPrimary
    else
      if primary_exists
      then
        if swung_and_staged
        then ok VlogRecoverAction.OpenNew
        else ok VlogRecoverAction.OpenPrimary
      else
        if swung_and_staged
        then ok VlogRecoverAction.OpenNew
        else ok VlogRecoverAction.NoVlog

