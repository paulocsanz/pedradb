/-- [pedra_aeneas_lsm_r1_kernel::r1_newest]: loop body 0:
    Source: '../../../crates/pedradb-core/src/lsm_r1_kernel.rs', lines 346:4-358:5
    Visibility: public -/
@[rust_loop_body]
def r1_newest_loop.body
  (s : LsmState) (key : Std.U64) (best : Option LsmEntry) (i : Std.Usize) :
  Result (ControlFlow ((Option LsmEntry) × Std.Usize) (Option LsmEntry))
  := do
  if i < MAX_LEVELS
  then
    let ll ← Array.index_usize s.levels i
    let o ← level_get ll key
    let best1 ←
      match o with
      | none => ok best
      | some e =>
        do
        let le ←
          match best with
          | none => ok e
          | some b =>
            do
            let (i1, i2, b1) ←
              if e.seq > b.seq
              then ok (e.key, e.seq, e.tomb)
              else ok (b.key, b.seq, b.tomb)
            ok ({ key := i1, seq := i2, tomb := b1 } : LsmEntry)
        ok (some le)
    let i1 ← i + 1#usize
    ok (cont (best1, i1))
  else ok (done best)

/-- [pedra_aeneas_lsm_r1_kernel::r1_newest]: loop 0:
    Source: '../../../crates/pedradb-core/src/lsm_r1_kernel.rs', lines 346:4-358:5
    Visibility: public -/
@[rust_loop]
def r1_newest_loop
  (s : LsmState) (key : Std.U64) (best : Option LsmEntry) (i : Std.Usize) :
  Result (Option LsmEntry)
  := do
  loop
    (fun (best1, i1) => r1_newest_loop.body s key best1 i1)
    (best, i)

