@[rust_loop_body]
def lsm_probe_loop.body
  (s : LsmState) (key : Std.U64) (i : Std.Usize) :
  Result (ControlFlow Std.Usize (Option LsmEntry))
  := do
  if i < MAX_LEVELS
  then
    let ll ← Array.index_usize s.levels i
    let o ← level_get ll key
    match o with
    | none => let i1 ← i + 1#usize
              ok (cont i1)
    | some _ => ok (done o)
  else ok (done none)

