    Source: 'src/../../../../crates/pedradb-core/src/wal/recover_kernel.rs', lines 263:0-283:1
    Visibility: public -/
def recover_kernel.fragment_act
  (kind : recover_kernel.FragKind) (scratch_empty : Bool) :
  Result recover_kernel.FragAct
  := do
  match kind with
  | recover_kernel.FragKind.Full => ok recover_kernel.FragAct.Yield
  | recover_kernel.FragKind.First => ok recover_kernel.FragAct.Start
  | recover_kernel.FragKind.Middle =>
    if scratch_empty
    then ok recover_kernel.FragAct.FailStop
    else ok recover_kernel.FragAct.Accumulate
  | recover_kernel.FragKind.Last =>
    if scratch_empty
    then ok recover_kernel.FragAct.FailStop
    else ok recover_kernel.FragAct.Yield
  | recover_kernel.FragKind.Zero => ok recover_kernel.FragAct.Skip

/-- [pedra_aeneas_wal_recover_kernel::recover_kernel::fragment_act_as_is]:
    Source: 'src/../../../../crates/pedradb-core/src/wal/recover_kernel.rs', lines 287:0-293:1
    Visibility: public -/
def recover_kernel.fragment_act_as_is
  (kind : recover_kernel.FragKind) (scratch_empty : Bool) :
  Result recover_kernel.FragAct
  := do
  if scratch_empty
  then
    let b ←
      match kind with
      | recover_kernel.FragKind.Full => ok false
      | recover_kernel.FragKind.First => ok false
      | recover_kernel.FragKind.Middle => ok true
      | recover_kernel.FragKind.Last => ok true
      | recover_kernel.FragKind.Zero => ok false
    if b
    then ok recover_kernel.FragAct.CleanEof
    else recover_kernel.fragment_act kind true
  else recover_kernel.fragment_act kind false

