    Visibility: public -/
def recover_kernel.recover_collect_act_as_is
  (kind : recover_kernel.RecoverKind) (_prefix_n : Std.U64) (_can_skip : Bool)
  (_consecutive_skips : Std.U64) :
  Result recover_kernel.RecoverAct
  := do
  match kind with
  | recover_kernel.RecoverKind.Record =>
    ok recover_kernel.RecoverAct.KeepRecord
  | recover_kernel.RecoverKind.CleanEof => ok recover_kernel.RecoverAct.Stop
  | recover_kernel.RecoverKind.Truncated => ok recover_kernel.RecoverAct.Stop
  | recover_kernel.RecoverKind.LengthCorrupt =>
