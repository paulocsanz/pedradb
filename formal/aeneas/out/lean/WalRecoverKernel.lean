def recover_kernel.recover_collect_act
  (kind : recover_kernel.RecoverKind) (prefix_n : Std.U64) (can_skip : Bool)
  (consecutive_skips : Std.U64) (in_resync : Bool) :
  Result recover_kernel.RecoverAct
  := do
  match kind with
  | recover_kernel.RecoverKind.Record =>
    ok recover_kernel.RecoverAct.KeepRecord
  | recover_kernel.RecoverKind.CleanEof => ok recover_kernel.RecoverAct.Stop
  | recover_kernel.RecoverKind.Truncated =>
    if can_skip
    then
      let i ← recover_kernel.MAX_CONSECUTIVE_SKIPS
      if consecutive_skips > i
      then ok recover_kernel.RecoverAct.FailStop
      else ok recover_kernel.RecoverAct.Resync
    else
      if prefix_n = 0#u64
      then ok recover_kernel.RecoverAct.FailStop
      else ok recover_kernel.RecoverAct.KeepPrefix
  | recover_kernel.RecoverKind.LengthCorrupt =>
    if can_skip
    then
      let i ← recover_kernel.MAX_CONSECUTIVE_SKIPS
      if consecutive_skips > i
      then ok recover_kernel.RecoverAct.FailStop
      else ok recover_kernel.RecoverAct.Resync
    else
      if prefix_n = 0#u64
      then ok recover_kernel.RecoverAct.FailStop
      else ok recover_kernel.RecoverAct.KeepPrefix
  | recover_kernel.RecoverKind.UnknownType =>
    if can_skip
    then
      let i ← recover_kernel.MAX_CONSECUTIVE_SKIPS
      if consecutive_skips > i
      then ok recover_kernel.RecoverAct.FailStop
      else ok recover_kernel.RecoverAct.Resync
    else
      if prefix_n = 0#u64
      then ok recover_kernel.RecoverAct.FailStop
      else ok recover_kernel.RecoverAct.KeepPrefix
  | recover_kernel.RecoverKind.OrphanFragment =>
    ok recover_kernel.RecoverAct.FailStop
  | recover_kernel.RecoverKind.Crc =>
    if in_resync
    then
      if can_skip
      then ok recover_kernel.RecoverAct.Resync
      else
        if prefix_n = 0#u64
        then ok recover_kernel.RecoverAct.FailStop
        else ok recover_kernel.RecoverAct.KeepPrefix
    else ok recover_kernel.RecoverAct.FailStop
  | recover_kernel.RecoverKind.ZeroHeaderTail =>
    if in_resync
    then
      if can_skip
      then ok recover_kernel.RecoverAct.Resync
      else
        if prefix_n = 0#u64
        then ok recover_kernel.RecoverAct.FailStop
        else ok recover_kernel.RecoverAct.KeepPrefix
    else ok recover_kernel.RecoverAct.FailStop
  | recover_kernel.RecoverKind.Other => ok recover_kernel.RecoverAct.FailStop

/-- [pedra_aeneas_wal_recover_kernel::recover_kernel::recover_collect_act_as_is]:
