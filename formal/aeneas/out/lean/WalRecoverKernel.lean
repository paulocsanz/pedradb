def recover_kernel.physical_payload_act
  (length : Std.U64) (max_payload : Std.U64) (payload_end : Std.U64)
  (block_end : Std.U64) (block_size : Std.U64) :
  Result recover_kernel.PhysicalAct
  := do
  if length > max_payload
  then ok recover_kernel.PhysicalAct.FailStop
  else
    if payload_end > block_end
    then
      if block_end = block_size
      then ok recover_kernel.PhysicalAct.FailStop
      else ok recover_kernel.PhysicalAct.Truncated
    else ok recover_kernel.PhysicalAct.Continue

