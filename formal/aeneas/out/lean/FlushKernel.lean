  if s.mem_empty
  then
    if s.imm_present
    then ok WalRotateAction.KeepWal
    else
      if s.pin_live
      then ok WalRotateAction.KeepWal
      else
        if s.parked_unflushed
        then ok WalRotateAction.KeepWal
        else
          if s.commit_inflight
          then ok WalRotateAction.KeepWal
          else ok WalRotateAction.RotateWal
  else ok WalRotateAction.KeepWal

