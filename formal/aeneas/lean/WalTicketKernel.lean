  (mem_bytes : Std.U64) (mem_armed : Bool) (mem_limit : Std.U64) (l0 : Std.U64)
  (l0_armed : Bool) (l0_limit : Std.U64) (need_sync : Bool)
  (sync_failed : Bool) (len : Std.U64) (last_good : Std.U64) :
  Result Bool
  := do
  let wa ←
