/-- [pedra_aeneas_wal_ticket_kernel::write_admission_kernel::storage_write_recovered]:
    Source: 'src/../../../../crates/pedradb-core/src/write_admission_kernel.rs', lines 681:0-700:1
    Visibility: public -/
def write_admission_kernel.storage_write_recovered
  (mem_bytes : Std.U64) (mem_armed : Bool) (mem_limit : Std.U64) (l0 : Std.U64)
  (l0_armed : Bool) (l0_limit : Std.U64) (need_sync : Bool)
  (sync_failed : Bool) (len : Std.U64) (last_good : Std.U64) :
  Result Bool
  := do
  let wa ←
    write_admission_kernel.write_admit mem_bytes mem_armed mem_limit l0
      l0_armed l0_limit
  match wa with
  | write_admission_kernel.WriteAdmit.Ok =>
    let wcp ← write_admission_kernel.wal_commit_plan need_sync sync_failed
    match wcp with
    | write_admission_kernel.WalCommitPlan.AppendApplyOk =>
      let b ← write_admission_kernel.torn_tail_needs_cut len last_good
      ok (¬ b)
    | write_admission_kernel.WalCommitPlan.AppendSyncApplyOk =>
      let b ← write_admission_kernel.torn_tail_needs_cut len last_good
      ok (¬ b)
    | write_admission_kernel.WalCommitPlan.AppendSyncFence => ok false
  | write_admission_kernel.WriteAdmit.StallMem => ok false
  | write_admission_kernel.WriteAdmit.StallL0 => ok false

/-- [pedra_aeneas_wal_ticket_kernel::write_admission_kernel::storage_write_recovered_as_is]:
    Source: 'src/../../../../crates/pedradb-core/src/write_admission_kernel.rs', lines 706:0-725:1
    Visibility: public -/
