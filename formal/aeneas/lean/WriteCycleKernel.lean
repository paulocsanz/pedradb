def write_admission_kernel.write_admit
  (mem_bytes : Std.U64) (mem_armed : Bool) (mem_limit : Std.U64) (l0 : Std.U64)
  (l0_armed : Bool) (l0_limit : Std.U64) :
  Result write_admission_kernel.WriteAdmit
  := do
  if mem_armed
  then
    if mem_bytes >= mem_limit
    then ok write_admission_kernel.WriteAdmit.StallMem
    else
      if l0_armed
      then
        if l0 >= l0_limit
        then ok write_admission_kernel.WriteAdmit.StallL0
        else ok write_admission_kernel.WriteAdmit.Ok
      else ok write_admission_kernel.WriteAdmit.Ok
  else
    if l0_armed
    then
      if l0 >= l0_limit
      then ok write_admission_kernel.WriteAdmit.StallL0
      else ok write_admission_kernel.WriteAdmit.Ok
    else ok write_admission_kernel.WriteAdmit.Ok

