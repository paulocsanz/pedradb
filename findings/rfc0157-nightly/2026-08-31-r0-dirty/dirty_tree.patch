+                self.index
+                    .partition_point(|h| h.first_user_key.as_ref() < lo)
+            })
+            .unwrap_or(0);
+        SstInternalStream {
+            table: self,
+            block_i,
+            block: None,
+            entry_i: 0,
+            failed: false,
+            hi_excl: hi_excl.map(Bytes::copy_from_slice),
         }
     }
 
