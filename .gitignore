# Research PDFs stay local; fichas / txt / catalog go in git.
/research/pdfs/**
!/research/pdfs/README.md
/research/fontes/**
!/research/fontes/README.md
!/research/fontes/**/*.txt
!/research/fontes/**/*.md

# Bench leftover engines. Keep JSON/MD/TXT reports; never commit DBs.
# GitHub rejects files over 100MB; SST dumps from parity runs are hundreds of MB.
**/*.sst
**/db-compat/
**/db-rocksdb/
