#!/usr/bin/env bash
# Aeneas anti-drift guard (RFC-0157 follow-up): blocks a commit that changes
# an extracted kernel without re-stamping the matching stamp. The detection
# already existed in pedra_formal.py (FAIL "aeneas SOURCE drifted"); the hole
# was commit time — 6 stamps drifted committed in 4b243d2 (repaired in
# c60deda). Data-driven: reads path=/sha256= from each
# formal/aeneas/out/SOURCE* — a new kernel with a new stamp enters on its own.
#
# Install (once per clone): git config core.hooksPath .githooks
# Emergency:                        git commit --no-verify
# (the full lint remains the gate; the hook is the first barrier)
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

fail=0
for stamp in formal/aeneas/out/SOURCE*; do
  [[ -f "$stamp" ]] || continue
  kpath=$(sed -n 's/^path=//p' "$stamp" 2>/dev/null)
  [[ -n "$kpath" ]] || continue
  # stamp outside the index (staged deletion): the lint handles that
  want=$(git show ":$stamp" 2>/dev/null | sed -n 's/^sha256=//p')
  [[ -n "$want" ]] || continue
  if git cat-file -e ":$kpath" 2>/dev/null; then
    k_staged=$(git show ":$kpath" | shasum -a 256 | cut -d' ' -f1)
  else
    k_staged=""
  fi
  # only required when this pair changed relative to HEAD
  k_head=$(git show "HEAD:$kpath" 2>/dev/null | shasum -a 256 | cut -d' ' -f1)
  w_head=$(git show "HEAD:$stamp" 2>/dev/null | sed -n 's/^sha256=//p')
  [[ "$k_staged" == "$k_head" && "$want" == "$w_head" ]] && continue
  if [[ -z "$k_staged" || "$k_staged" != "$want" ]]; then
    name=${stamp##*/}; name=${name#SOURCE}; name=${name#.}
    [[ -z "$name" ]] && name=vote
    echo "pre-commit: aeneas drift — $kpath ≠ $stamp" >&2
    echo "  re-extract and stamp: scripts/aeneas_${name}.sh --required && git add $stamp formal/aeneas/out/lean/" >&2
    fail=1
  fi
done
exit $fail
